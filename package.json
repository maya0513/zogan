{
  "name": "zogan",
  "version": "0.0.0",
  "description": "Explicit HTML fragments and typed islands for Hono and Preact",
  "license": "MIT",
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./fragments": {
      "types": "./dist/fragments/index.d.ts",
      "default": "./dist/fragments/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.mts",
      "default": "./dist/vite/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./fragments": {
        "types": "./dist/fragments/index.d.ts",
        "default": "./dist/fragments/index.js"
      },
      "./vite": {
        "types": "./dist/vite/index.d.mts",
        "default": "./dist/vite/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "hono": "^4.13.1",
    "jsdom": "^30.0.1",
    "preact": "^10.29.8",
    "publint": "^0.3.23",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plus": "^0.2.8",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "hono": ">=4.13.0 <5",
    "preact": ">=10.29.8 <11",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.20.0"
}
