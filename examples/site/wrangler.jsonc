{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zogan",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
