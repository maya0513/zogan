{
  "name": "@zogan/shop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log vite",
    "build": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log vite build",
    "preview": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log vite preview",
    "test": "WRANGLER_LOG_PATH=/tmp/zogan-shop-test-wrangler.log vitest run --config vitest.config.ts",
    "e2e": "playwright test",
    "cf-typegen": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log wrangler types src/worker-configuration.d.ts",
    "cf-typegen:check": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log wrangler types src/worker-configuration.d.ts --check",
    "db:migrate": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log wrangler d1 migrations apply zogan-shop --local",
    "db:seed": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log wrangler d1 execute zogan-shop --local --file=seed.sql",
    "db:setup": "vp run db:migrate && vp run db:seed",
    "db:migrate:remote": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log wrangler d1 migrations apply zogan-shop --remote",
    "db:seed:remote": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log wrangler d1 execute zogan-shop --remote --file=seed.sql --yes",
    "deploy:dry": "WRANGLER_LOG_PATH=/tmp/zogan-shop-wrangler.log wrangler deploy --dry-run"
  },
  "dependencies": {
    "@preact/signals": "^2.11.0",
    "hono": "^4.13.1",
    "preact": "^10.29.8",
    "zogan": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
